  "cards": [
    {
      "dot": "cyan",
      "title": "Once a day, never in the way",
      "items": [
        "Startup never waits on npm; a failed check changes nothing",
        "Off under CI or LEGLAS_NO_UPDATE_CHECK=1; the panel still checks by hand"
      ]
    },
    {
      "dot": "violet",
      "title": "Update runs what the install kind needs",
      "items": [
        "npx: no install, the restart is npx leglas@1.1.0; global and project use their manager",
        "A checkout is told to pull; Skip quietens a version until the next one"
      ]
    },
    {
      "dot": "emerald",
      "title": "The old process hands over",
      "items": [
        "It closes its server first, forwards Ctrl+C and exits with the child's code",
        "The page reloads once 1.1.0 answers, and gives up after 90 seconds"
      ]
    }
  ]
