  "cards": [
    {
      "dot": "cyan",
      "title": "Why a ceiling at all",
      "items": [
        "A dev server does not fail under a burst, it queues inside itself",
        "The sharer's own reload joins the back of that queue",
        "Held at twelve: sharer 136ms to 21ms, and the burst ran faster"
      ]
    },
    {
      "dot": "amber",
      "title": "Measured, not guessed",
      "items": [
        "A real page load peaks at 6 at once, so twelve never waits",
        "Latency-based shedding shed nothing at 153 in flight",
        "8 of 22 files are dot paths, so hidden stops at node_modules"
      ]
    }
  ]
