  "cards": [
    {
      "dot": "cyan",
      "title": "Derived, so it cannot drift",
      "items": [
        "The environment is the repo at the fix's parent commit, history cut off there",
        "The hidden tests are the test files the fix touched, at the fix commit",
        "The oracle is the fix's diff without tests or changelog; the oracle run applies it instead of an agent"
      ]
    },
    {
      "dot": "rose",
      "title": "The verifier, after review",
      "items": [
        "Refuses a run that changed vitest.config.ts or the package manifests",
        "Checks by name that every hidden file was collected and passed, since a green exit is also what an empty run returns"
      ]
    },
    {
      "dot": "slate",
      "title": "Kept out of the suite",
      "items": [
        "vitest excludes evals/, so the hidden copies never run here",
        "evals/jobs/ is ignored; results/ keeps the 2026-09-16 run",
        "oracle 8/8 and nop 0/8 calibrate before any agent is believed"
      ]
    }
  ]
