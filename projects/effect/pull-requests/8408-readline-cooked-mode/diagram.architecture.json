  "cards": [
    {
      "dot": "rose",
      "title": "Before",
      "items": [
        "Acquiring rlRef also called setRawMode(true), so readLine ran raw: nothing echoed, Ctrl+U landed in the line and Ctrl+C was ignored."
      ]
    },
    {
      "dot": "emerald",
      "title": "After",
      "items": [
        "readLine never takes rawModeRef. The terminal echoes, edits the line and turns Ctrl+C into SIGINT.",
        "Prompts still hold raw mode for their whole scope, so password input is never echoed."
      ]
    }
  ]
