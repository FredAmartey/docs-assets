  "cards": [
    {
      "dot": "emerald",
      "title": "Every other path is unchanged",
      "items": [
        "Non-root paths still go through validateParent, so a symlink in the last component is inspected, not followed."
      ]
    },
    {
      "dot": "amber",
      "title": "Kept on purpose",
      "items": [
        "rm, mv, cp and symlink still reject the root. The rm command has no --preserve-root guard, so that rejection is what keeps rm -rf / off the host directory."
      ]
    }
  ]
